# Copy this file to .env.local and fill in your values.
# Most variables are optional; the app falls back gracefully when AI or monitoring
# features are not configured.

# AI narrative generation (server-side only)
ANTHROPIC_API_KEY=

# Recommended canonical site URL used for SEO metadata and metadata routes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile config for anti-bot protection. Optional in development.
# Required in production: readings fail with a 503 until both values are set.
# Set the site key before building; NEXT_PUBLIC_ values are inlined at build time.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Sentry DSNs for error monitoring.
# Server-side monitoring (API/runtime):
SENTRY_DSN=
# Browser/runtime monitoring:
NEXT_PUBLIC_SENTRY_DSN=

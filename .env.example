# Copy this file to .env.local and fill in your key.
# Without a key, the site still works: readings fall back to the runes'
# traditional meanings, just without the AI-personalised interpretation.

ANTHROPIC_API_KEY=

# Optional Cloudflare Turnstile config for anti-bot protection.
# In production, set both values to require challenge verification.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Sentry DSNs for error monitoring.
# Server-side monitoring (API/runtime):
SENTRY_DSN=
# Browser/runtime monitoring:
NEXT_PUBLIC_SENTRY_DSN=
